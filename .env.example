# ============================================================
# TikTok Bot Shop - Contoh konfigurasi
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# ---------- Wajib ----------

# Token bot dari @BotFather
BOT_TOKEN=

# API key PanzzPay (wajib, bot tidak mau jalan tanpa ini)
PANZZ_API_KEY=

# Koneksi MySQL (wajib)
# Format: user:password@tcp(host:port)/namadb?parseTime=true&loc=UTC&charset=utf8mb4
MYSQL_DSN=tiktok_bot:password@tcp(127.0.0.1:3309)/tiktok_bot?parseTime=true&loc=UTC&charset=utf8mb4

# Akses S3 untuk stok akun (wajib)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Bot Telegram ----------

# Chat ID admin bot (dipisah koma), menerima notifikasi order/gagal kirim
BOT_ADMIN_IDS=123456789

# ---------- Object storage stok akun ----------

# Endpoint S3 tempat file .tar.gz / .json akun disimpan (private)
S3_ENDPOINT=http://127.0.0.1:9001
S3_BUCKET=tiktok-account
S3_REGION=us-east-1

# ---------- Object storage banner (terpisah dari stok) ----------

# Bucket banner diakses publik untuk ditampilkan di Home bot.
# BANNER_PUBLIC_BASE harus URL publik yang bisa diakses Telegram.
BANNER_S3_ENDPOINT=http://127.0.0.1:9000
BANNER_S3_ACCESS_KEY=root-access
BANNER_S3_SECRET=root-secret
BANNER_S3_BUCKET=tiktok-banner
BANNER_PUBLIC_BASE=https://storage.contoh.com/banner/

# ---------- Payment gateway (PanzzPay) ----------

# Base URL gateway
PANZZ_BASE_URL=https://panzzpay.my.id

# Bot memakai polling status, tapi webhook_url wajib diisi saat buat invoice.
# Arahkan ke path apa pun di domain Anda; tidak ada handler khusus yang perlu dibuat.
PAYMENT_WEBHOOK_URL=https://domain-anda/webhook/payment

# ---------- Aturan jualan ----------

# Maksimal akun per order (1-100), bisa diubah lagi dari panel admin
MAX_ACCOUNTS_PER_ORDER=100

# Harga per akun (Rupiah, minimal 1000)
PRICE_PER_ACCOUNT=1000

# Batas ukuran ZIP pengiriman (bytes)
MAX_ZIP_BYTES=45000000

# ---------- Panel admin ----------

# Alamat listen panel (dibalik nginx)
ADMIN_ADDR=:8091

# Login awal panel; perubahan password dari panel tersimpan di MySQL
ADMIN_USER=admin
ADMIN_PASS=ubah-password-ini

# ---------- Lain-lain ----------

# Zona waktu untuk tampilan tanggal & umur stok
TZ=Asia/Jakarta

# Opsional: URL banner default bila belum diatur dari panel
# HOME_BANNER_URL=
